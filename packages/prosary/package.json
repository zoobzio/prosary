{
  "name": "prosary",
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoobzio/prosary.git",
    "directory": "packages/prosary"
  },
  "type": "module",
  "main": "./.dist/index.mjs",
  "types": "./.dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./.dist/index.d.mts",
      "import": "./.dist/index.mjs"
    },
    "./parse": {
      "types": "./.dist/parse.d.mts",
      "import": "./.dist/parse.mjs"
    }
  },
  "files": [
    ".dist"
  ],
  "scripts": {
    "build": "obuild",
    "stub": "obuild --stub",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@prosary/core": "workspace:*",
    "@prosary/parse": "workspace:*",
    "@prosary/schema": "workspace:*"
  }
}
