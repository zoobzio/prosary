{
  "name": "@prosary/kit",
  "version": "0.0.1",
  "description": "Build kit: enumerated content to per-locale JSON and typed modules",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoobzio/prosary.git",
    "directory": "packages/kit"
  },
  "type": "module",
  "main": "./.dist/index.mjs",
  "types": "./.dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./.dist/index.d.mts",
      "import": "./.dist/index.mjs"
    }
  },
  "bin": {
    "prosary": "./bin/prosary.mjs"
  },
  "files": [
    ".dist",
    "bin"
  ],
  "scripts": {
    "build": "obuild",
    "stub": "obuild --stub",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "catalog:",
    "@prosary/parse": "workspace:*",
    "@prosary/schema": "workspace:*",
    "hast-util-to-html": "catalog:",
    "jiti": "catalog:",
    "objectively": "catalog:",
    "unist-util-visit": "catalog:",
    "vfile-message": "catalog:"
  },
  "peerDependencies": {
    "@prosary/translate": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@prosary/translate": {
      "optional": true
    }
  },
  "devDependencies": {
    "@prosary/translate": "workspace:*",
    "@types/hast": "catalog:",
    "@types/node": "catalog:",
    "intl-messageformat": "catalog:"
  }
}
