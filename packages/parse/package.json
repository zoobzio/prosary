{
  "name": "@prosary/parse",
  "version": "0.0.1",
  "description": "The Markdown pipeline: CommonMark to an HTML tree, extended by presets",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoobzio/prosary.git",
    "directory": "packages/parse"
  },
  "type": "module",
  "main": "./.dist/index.mjs",
  "types": "./.dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./.dist/index.d.mts",
      "import": "./.dist/index.mjs"
    },
    "./plugins": {
      "types": "./.dist/plugins/index.d.mts",
      "import": "./.dist/plugins/index.mjs"
    }
  },
  "files": [
    ".dist"
  ],
  "scripts": {
    "build": "obuild",
    "stub": "obuild --stub",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@types/hast": "catalog:",
    "@types/mdast": "catalog:",
    "mdast-util-directive": "catalog:",
    "mdast-util-to-hast": "catalog:",
    "objectively": "catalog:",
    "remark-directive": "catalog:",
    "remark-frontmatter": "catalog:",
    "remark-gfm": "catalog:",
    "remark-parse": "catalog:",
    "remark-rehype": "catalog:",
    "unified": "catalog:",
    "unist-util-visit": "catalog:",
    "vfile": "catalog:",
    "yaml": "catalog:"
  }
}
