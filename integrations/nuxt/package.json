{
  "name": "@prosary/nuxt",
  "version": "0.0.4",
  "description": "Nuxt module for prosary — builds the app's messages, loads one locale per visitor, and provides `$t`",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoobzio/prosary.git",
    "directory": "integrations/nuxt"
  },
  "type": "module",
  "main": "./.dist/module.js",
  "types": "./.dist/module.d.ts",
  "exports": {
    ".": {
      "types": "./.dist/module.d.ts",
      "import": "./.dist/module.js"
    },
    "./config": {
      "types": "./.dist/config.d.ts",
      "import": "./.dist/config.js"
    },
    "./constant": {
      "types": "./.dist/constant.d.ts",
      "import": "./.dist/constant.js"
    }
  },
  "files": [
    ".dist"
  ],
  "scripts": {
    "build": "obuild",
    "stub": "obuild --stub",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nuxt/kit": "catalog:",
    "@prosary/vue": "workspace:*",
    "@types/hast": "catalog:",
    "prosary": "workspace:*",
    "vue": "catalog:"
  },
  "peerDependencies": {
    "@prosary/kit": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@prosary/kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@prosary/kit": "workspace:*",
    "@nuxt/nitro-server": "catalog:",
    "@nuxt/schema": "catalog:",
    "@types/node": "catalog:",
    "nuxt": "catalog:"
  }
}
